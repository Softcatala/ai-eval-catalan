<style>
  .eval-table { border-collapse: collapse; width: auto; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; font-size: 13px; color: #222; background: #fff; }
  .eval-table th { background: #fff; border: 1px solid #ddd; padding: 7px 12px; font-weight: 600; color: #1a1a1a; text-align: left; }
  .eval-table td { border: 1px solid #ddd; padding: 6px 12px; background: #fff; }
  .eval-table a { text-decoration: underline; text-underline-offset: 2px; }
  .eval-table tbody tr:hover td { background: #f9f9f9; }
</style>
<table class="eval-table">
<thead>
<tr>
<th>Model</th>
{% for col in cols %}<th>{{ col_labels.get(col, col) }}</th>{% endfor %}
</tr>
</thead>
<tbody>
{% for row in rows %}
<tr>
<td>{% if row.repo_url %}<a href="{{ row.repo_url | e }}" style="color: inherit;" target="_blank" rel="noopener noreferrer">{% endif %}{% if row.cloud %}<b>{{ row.model | e }}</b>{% else %}{{ row.model | e }}{% endif %}{% if row.repo_url %}</a>{% endif %}</td>
{% for col in cols %}<td>{{ row[col] | fmt }}</td>{% endfor %}
</tr>
{% endfor %}
</tbody>
</table>
